# LLMs
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_VERSION="2024-02-15-preview"
COHERE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
QWEN_API_KEY=
QWEN_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Vector Database
QDRANT_API_KEY="test"

# Embeddings
# provider: qwen / dashscope（付费）| local（fastembed 本地）| siliconflow（免费网关）
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_SIZE=768
EMBEDDING_BATCH_SIZE=0

# 免费替代：硅基流动（BAAI/bge-m3 免费，需实名认证）
# EMBEDDING_PROVIDER=siliconflow
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# EMBEDDING_SIZE=1024
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxx

# 零成本本地替代（需先下载 ~95MB 模型）
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# EMBEDDING_SIZE=512

# Database
# 本地开发默认账号（docker compose 会创建并授权 fitness_agent 库）；
# 生产环境请改成独立强密码，并同步修改 MySQL 授权。
MYSQL_USER=fitness_app
MYSQL_PASSWORD=change-me
DATABASE_URL=mysql+aiomysql://fitness_app:change-me@localhost:3307/fitness_agent

# Conversation Checkpoint（会话状态持久化）
# memory = 进程内（重启丢，测试用）/ sqlite = 单文件 / postgres = 生产
CHECKPOINT_BACKEND=memory
POSTGRES_DSN=postgresql://fitness:fitness@localhost:5433/fitness_agent
SQLITE_CHECKPOINT_PATH=data/checkpoints.sqlite
CHECKPOINT_TTL_DAYS=30

# HITL —— 训练记录写入前的人工确认（仅 Agent 调用路径生效）
WORKOUT_CONFIRM_ENABLED=true
# 训练计划生成前的确认（仅 Agent 调用路径生效；人体图直接生成不走确认）
PLAN_CONFIRM_ENABLED=true

# 文档分块与 Contextual Retrieval
CONTEXTUAL_RETRIEVAL_ENABLED=false
# 离线/内网环境：指向本地 BM25 模型目录，跳过 HuggingFace 下载
BM25_MODEL_PATH=resources/bm25_model
# 离线/内网环境：指向本地重排模型目录（留空则按模型名在线拉取）
BGE_RERANKER_PATH=

# 重排序
RERANK_PROVIDER=bge          # bge（本地）/ siliconflow（远程免费）/ flashrank / none
RERANK_TOP_K=5
# 送进 Cross-Encoder 的候选数：40 条在 CPU 上要 30 秒，15 条约 8 秒
RERANK_CANDIDATES=15
# 远程重排（硅基流动 BAAI/bge-reranker-v2-m3 免费，需实名认证）
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_API_MODEL=BAAI/bge-reranker-v2-m3

# Tracing
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
