# ============================================================
# 前端 React 镜像 — 多阶段构建：Node 打包静态文件，nginx 托管
# ============================================================

# ----- 阶段一：构建 -----
FROM node:22-alpine AS build

WORKDIR /app

# 先只复制依赖声明，命中 Docker 层缓存（源码变动不会触发重新装依赖）
# 注意：context 是项目根目录，所以路径写成 frontend/package.json
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# 再复制源码并构建。`npm run build` 会先跑 tsc --noEmit，
# 类型错误会直接让镜像构建失败 —— 这是有意的。
COPY frontend/ .
RUN npm run build

# ----- 阶段二：运行 -----
# 只带走 dist/，最终镜像里没有 node_modules，体积从几百 MB 降到几十 MB
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# EXPOSE 只是文档标记，实际端口映射由 docker-compose.yml 的 ports 控制
EXPOSE 80
